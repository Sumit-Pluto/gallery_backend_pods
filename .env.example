# =============================================================================
# crm-ai-backend — environment reference.
#
# Nothing here is read from a file in production: these are set as env vars on
# each RunPod pod (Pod -> Edit -> Environment Variables). Secrets belong in
# RunPod Secrets, never in this repo.
#
# Copy to .env for local docker-compose runs only.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. WHAT THE CLIENT GETS. These two, and nothing else.
# -----------------------------------------------------------------------------
# CRM_AI_BASE_URL=https://<gateway-pod-id>-8000.proxy.runpod.net
# CRM_AI_API_KEY=<one of CLIENT_API_KEYS below>


# -----------------------------------------------------------------------------
# 2. GATEWAY POD
# -----------------------------------------------------------------------------
# One key per consumer, comma separated. Rotate by adding the new key, handing
# it over, then removing the old one on the next restart.
CLIENT_API_KEYS=change-me-client-key

# Shared secret between the gateway and the backend pods. The pod proxy URLs are
# public, so this is what stops anyone else from calling them directly.
# Generate: openssl rand -hex 32
INTERNAL_API_KEY=change-me-internal-key

# Where the backend pods live. Each pod's HTTP port is at
#   https://<POD_ID>-8000.proxy.runpod.net
VISION_URL=
DIFFUSION_URL=
CPU_URL=

# The pre-existing chat pod (Qwen via Ollama + NLLB translate). Not built by this
# repo — the gateway only fronts it so the client has one host.
CHAT_URL=https://<chat-pod-id>-11434.proxy.runpod.net
TRANSLATE_URL=https://<chat-pod-id>-8000.proxy.runpod.net
CHAT_POD_KEY=

# Used to build the `poll` URL returned with a 202. Set it to the gateway's own
# public URL or clients get a relative path.
PUBLIC_BASE_URL=https://<gateway-pod-id>-8000.proxy.runpod.net

# Detection backend: vlm (Qwen, no GPU, open vocabulary) | yolo (vision pod)
DETECT_BACKEND=vlm
# Automatic VLM -> YOLO fallback. OFF by default: YOLO has a fixed class list and
# cannot produce the open-vocabulary labels the gallery indexes, and it runs on
# the vision pod's single GPU slot alongside upscale/transcribe. Redundancy now
# comes from the cpu pod's provider chain instead. Rate limits never trigger it.
DETECT_FALLBACK_TO_YOLO=false
# Max images per POST /v1/vision/detect-batch. Keep <= the cpu pod's DETECT_MAX_BATCH.
DETECT_MAX_BATCH=32

# Limits
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30
MAX_BODY_BYTES=33554432
MAX_MEDIA_BYTES=26214400
JOB_TTL_SECONDS=1800
JOB_MAX_QUEUED=64
SYNC_WAIT_MAX=60

# Empty = CORS off = backend-to-backend only. Turning this on puts the API key in
# a browser; read docs/API.md before you do.
CORS_ORIGINS=

# Upstream timeouts (seconds)
TIMEOUT_FAST=120
TIMEOUT_VISION=600
TIMEOUT_DIFFUSION=900
UPSTREAM_RETRIES=2


# -----------------------------------------------------------------------------
# 3. VISION POD  (RTX A4000 16 GB)
# -----------------------------------------------------------------------------
INTERNAL_API_KEY=change-me-internal-key
DATA_DIR=/workspace

# tile=0 makes VRAM scale with image size and is how you OOM a 16 GB card.
# 400 caps it at a flat ~2-3 GB. Set 0 only on a 24 GB+ card.
ESRGAN_TILE=400
WHISPER_MODEL=medium
WHISPER_COMPUTE=float16

# YOLO is the fallback path only — object detection goes through the VLM.
# Weights live on the volume, not in the image.
YOLO_MODEL=/workspace/weights/yolo_large_v3.pt

# One inference at a time per card. Raising this is how you OOM in production.
GPU_CONCURRENCY=1


# -----------------------------------------------------------------------------
# 4. DIFFUSION POD  (RTX A5000 / 4090, 24 GB)
# -----------------------------------------------------------------------------
INTERNAL_API_KEY=change-me-internal-key
DATA_DIR=/workspace
HF_HOME=/workspace/huggingface

FLUX2_MODEL=black-forest-labs/FLUX.2-klein-4B
FLUX2_STEPS=6
SD_INPAINT_MODEL=diffusers/stable-diffusion-xl-1.0-inpainting-0.1
MAX_SIZE=1024

# both = keep FLUX and SDXL resident (fastest, needs headroom)
# swap = one at a time (fits a smaller card, ~15-30 s on a task switch)
# auto = measure at boot and choose. Check /healthz after the first boot for the
#        measured footprint, then pin it.
RESIDENCY=auto
GPU_CONCURRENCY=1


# -----------------------------------------------------------------------------
# 5. CPU POD  (4 vCPU / 16 GB)
# -----------------------------------------------------------------------------
INTERNAL_API_KEY=change-me-internal-key
DATA_DIR=/workspace

# --- LLM / VLM providers ---
# Both speak the OpenAI /chat/completions shape, so only URL, keys and model
# names differ. Tried in this order; the chain advances when a provider is down
# or every one of its keys is throttled.
#
# Model Studio first: first-party Qwen, production (not preview) status, cheaper
# per token, and limits you can raise on a paid account. Groq is the failover.
LLM_PROVIDERS=dashscope,groq

# Alibaba Cloud Model Studio (DashScope), OpenAI-compatible mode.
#   Singapore  https://dashscope-intl.aliyuncs.com/compatible-mode/v1   <- best latency from India
#   Virginia   https://dashscope-us.aliyuncs.com/compatible-mode/v1
#   Beijing    https://dashscope.aliyuncs.com/compatible-mode/v1        <- cheaper; check data residency FIRST
# Sign up through alibabacloud.com (international), not the mainland DashScope
# console, which asks for a Chinese phone number.
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Comma-separated. Rotated automatically on 429/quota — more keys = more headroom.
DASHSCOPE_API_KEYS=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_VISION_MODEL=qwen-vl-plus

# Groq. Keep configured as failover even after moving primary to Model Studio —
# different infrastructure is what makes it real redundancy.
GROQ_API_KEYS=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# --- detection tuning ---
# Long edge the image is downscaled to before it is sent. Detection recognises,
# it does not localise, so it does not need source resolution — 4032px -> 768px
# is ~28x fewer pixels, and pixels are what a vision model bills for. Raise it if
# small objects (a clock on a far wall) get missed.
DETECT_MAX_SIDE=768
DETECT_JPEG_QUALITY=85
# auto | json_schema | json_object. "auto" tries strict schemas and remembers, per
# provider, if only json_object is supported.
DETECT_STRUCTURED_MODE=auto
# Fill a whole-image box into each detection so clients typed against the YOLO
# contract keep validating. Nothing reads it; turn off once the client's type
# makes `box` optional.
DETECT_EMIT_BOX=true
# Fan-out for /detect-batch. This semaphore is what stops a 200-photo upload
# walking straight into the provider's rate limit.
DETECT_BATCH_CONCURRENCY=8
DETECT_MAX_BATCH=32
# Comma-separated canonical labels. Unanchored, a VLM returns "hard hat",
# "hardhat" and "safety helmet" for one object and each becomes its own album.
# Leave unset for the built-in construction vocabulary.
DETECT_VOCABULARY=

# --- worker pools ---
# Blocking work (rembg, OCR, denoise) and image prep get separate bounded pools
# rather than sharing the interpreter's default executor. Two reasons, both of
# which only appear under real pod concurrency: the default pool has no
# admission control (50 requests queue on 8 threads, each holding a decoded
# image), and it is shared, so a 32-image detection batch starves background
# removal. Unset = sized to the pod's cores.
HEAVY_POOL_WORKERS=
HEAVY_POOL_TIMEOUT=60
PREP_POOL_WORKERS=
PREP_POOL_TIMEOUT=30

BG_REMOVE_MODEL=u2net
OCR_MODEL_DIR=/workspace/ocr
OCR_ENABLED=true


# -----------------------------------------------------------------------------
# 6. CODE HOT-RELOAD (all pods, optional)
# -----------------------------------------------------------------------------
# With these set, a pod restart pulls the latest Python from GitHub instead of
# needing an image rebuild — ~15 s instead of ~15 min. Deps still come from the
# image. Leave CODE_REF unset to run exactly what was baked in.
# CODE_REPO=https://github.com/Sumit-Pluto/gallery_backend_pods.git
#   private repo: https://x-access-token:<github-pat>@github.com/Sumit-Pluto/gallery_backend_pods.git
# CODE_REF=main
